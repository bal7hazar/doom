# Node / build artifacts.
node_modules/
dist/
coverage/
*.tsbuildinfo

# Runtime assets: the client fetches these at run time; they are never committed.
# `npm run assets` regenerates them (downloads the WAD, runs tools/wad).
# Freedoom is BSD-licensed, so shipping the WAD in a *production* deployment is
# fine - it just must not live in git history.
public/freedoom1.wad
public/levels/

# Generated test fixtures (derived from the WAD, see test/fixtures/generate.ts).
test/fixtures/generated/

# Playwright artifacts.
playwright-report/
test-results/
e2e/artifacts/
