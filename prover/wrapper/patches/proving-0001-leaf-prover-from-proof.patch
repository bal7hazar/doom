+/// The serializations of a whole [`CairoProof`] this crate can read back.
+///
+/// Only the **extended** proof can be wrapped into a leaf: the verifier circuit is filled from
+/// [`stwo::core::proof::ExtendedStarkProof::aux`], which the Rust-verifier forms
+/// (`cairo_air::utils::ProofFormat::{Json, Binary}`, i.e. `CairoProofForRustVerifier`) drop, and
+/// `ProofFormat::CairoSerde` is write-only (`CairoProof` derives `CairoSerialize` but not
+/// `CairoDeserialize`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, ValueEnum)]
+pub enum CairoProofInputFormat {
+    /// `bincode` of a [`CairoProof`], optionally bzip2-compressed. Covers both what
+    /// `stwo_run_and_prove` writes with the `extended-binary` proof format (bzip2-wrapped) and
+    /// the raw `bincode::serialize(&CairoProof)` bytes another front end - a wasm prover, say -
+    /// hands over.
+    ExtendedBinary,
+    /// `serde_json` of a [`CairoProof`]. Note this is *not* `ProofFormat::Json`, which writes the
+    /// smaller `CairoProofForRustVerifier`.
+    #[clap(alias = "json")]
+    ExtendedJson,
+}
+
+/// Reads a whole [`CairoProof`] from `cairo_proof_path`.
+pub fn read_cairo_proof(
+    cairo_proof_path: &Path,
+    cairo_proof_format: CairoProofInputFormat,
+) -> CairoProof<Blake2sMerkleHasher> {
+    let bytes = std::fs::read(cairo_proof_path).unwrap_or_else(|err| {
+        panic!("Cannot read Cairo proof from {}: {err}", cairo_proof_path.display())
+    });
+    let fail = |err: &dyn std::fmt::Display| -> ! {
+        panic!(
+            "{} does not hold a {cairo_proof_format:?} extended CairoProof: {err}",
+            cairo_proof_path.display()
+        )
+    };
+    match cairo_proof_format {
+        CairoProofInputFormat::ExtendedBinary => {
+            bincode::deserialize(&decompress_if_needed(&bytes)).unwrap_or_else(|err| fail(&err))
+        }
+        CairoProofInputFormat::ExtendedJson => {
+            serde_json::from_slice(&bytes).unwrap_or_else(|err| fail(&err))
+        }
+    }
+}
+
+/// bzip2-decompresses `bytes` if they carry the bzip2 magic, and passes them through otherwise.
+fn decompress_if_needed(bytes: &[u8]) -> std::borrow::Cow<'_, [u8]> {
+    const BZIP2_MAGIC: &[u8] = b"BZh";
+    if !bytes.starts_with(BZIP2_MAGIC) {
+        return std::borrow::Cow::Borrowed(bytes);
+    }
+    let mut decompressed = Vec::new();
+    bzip2::read::BzDecoder::new(bytes)
+        .read_to_end(&mut decompressed)
+        .unwrap_or_else(|err| panic!("bzip2 decompression of the Cairo proof failed: {err}"));
+    std::borrow::Cow::Owned(decompressed)
+}
+
+/// File-path front end of [`prove_leaf_from_proof`]: loads the program, the Cairo proof to wrap
+/// and the circuit registry from disk.
+pub fn prove_leaf_from_proof_files(
+    program_path: &Path,
+    cairo_proof_path: &Path,
+    cairo_proof_format: CairoProofInputFormat,
+    circuit_registry_json: &Path,
+) -> SerializedLeafProof {
+    let program = get_program(program_path)
+        .unwrap_or_else(|err| panic!("Cannot get program from {}: {err}", program_path.display()));
+    let proof = read_cairo_proof(cairo_proof_path, cairo_proof_format);
+    let circuit_registry =
+        CircuitRegistry::from_path(circuit_registry_json).unwrap_or_else(|err| panic!("{err}"));
+    prove_leaf_from_proof(&proof, &program, &circuit_registry)
+}
