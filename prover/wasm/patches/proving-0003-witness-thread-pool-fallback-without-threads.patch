+
+/// Runs `f` inside `pool` when one could be built, on the calling thread otherwise (wasm without
+/// threads: `ThreadPoolBuilder::build` fails with `Unsupported`).
+pub fn install_or_inline<R: Send>(
+    pool: Option<&rayon::ThreadPool>,
+    f: impl FnOnce() -> R + Send,
+) -> R {
+    match pool {
+        Some(pool) => pool.install(f),
+        None => f(),
     }
 }
