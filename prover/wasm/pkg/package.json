{
  "name": "@hellproof/prover-wasm",
  "version": "0.1.0",
  "private": true,
  "description": "Stwo Cairo prover (WASM64/Memory64) for the browser: execute -> prove -> verify a Cairo segment, off the main thread, with an optional rayon Worker pool",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./worker": "./dist/prover-worker.js",
    "./thread-worker": "./dist/thread-worker.js",
    "./wasm/*": "./wasm/*"
  },
  "files": [
    "dist",
    "wasm",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24"
  }
}
